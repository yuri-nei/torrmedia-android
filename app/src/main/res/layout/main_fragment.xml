<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- List search. A field always on screen ate almost a whole list row on a TV,
         and it is rarely used with a remote, so it opens on demand: the "Search" item
         in the left menu or the remote's search button (TorrentsFragment.openSearch),
         and hides once focus leaves it. No clear button inside the field: moving to it
         with the remote would hide the field; clearing is on the strip below. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/search"
        android:visibility="gone"
        app:startIconDrawable="@drawable/round_search_24">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- A query is set but the field is closed: a thin strip shows it and the match
         count. Otherwise the filtered list would look as if torrents had vanished. OK on
         the text edits it again, the cross clears it. -->
    <LinearLayout
        android:id="@+id/searchChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingLeft="8dp"
        android:paddingEnd="8dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchEdit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:icon="@drawable/round_search_24"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchClear"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:contentDescription="@string/search_clear"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_search_clear"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="?attr/colorPrimary" />
    </LinearLayout>

    <ru.yourok.torrserve.ui.widgets.PatchedListView
        android:id="@+id/lvTorrents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?android:attr/listDivider"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="84dp"
        android:listSelector="@drawable/action_selector"
        android:requiresFadingEdge="vertical">

        <requestFocus />
    </ru.yourok.torrserve.ui.widgets.PatchedListView>

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/no_torrents"
        android:textSize="18sp"
        android:visibility="gone" />

</LinearLayout>

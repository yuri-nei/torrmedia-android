<?xml version="1.0" encoding="utf-8"?>
<!-- The new screen appears once the old one has faded out (see screen_exit) and
     grows slightly to its full size, which shows that the next level has opened.
     Until startOffset it is fully transparent. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:startOffset="90">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
    <scale
        android:fromXScale="0.97"
        android:fromYScale="0.97"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>

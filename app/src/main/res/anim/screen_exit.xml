<?xml version="1.0" encoding="utf-8"?>
<!-- Screen change through the background (fade through): the outgoing screen fades out
     quickly and completely, and only then does the new one appear. The screens are
     transparent and the container is a FrameLayout that draws the outgoing view over the
     incoming one, so a plain cross-fade laid the old screen's text over the new one's
     for half a second. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="90"
    android:fromAlpha="1.0"
    android:interpolator="@android:interpolator/accelerate_quad"
    android:toAlpha="0.0" />
